---
import Site from '../layouts/Site.astro';
import AircraftCard from '../components/aircraft/AircraftCard';
import { loadPublicContent } from '../api/public-content';
const {aircraft}=await loadPublicContent();
---
<Site><section class="bg-gradient-to-r from-primary-600 to-primary-700 text-white"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28 text-center"><h1 class="text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">Find Your Perfect Aircraft</h1><p class="mt-6 text-xl text-primary-100 max-w-3xl mx-auto">The premier marketplace by pilots and for pilots. Discover your next aircraft with confidence, trust, and panache.</p><form action="/aircraft" class="mt-10 max-w-2xl mx-auto flex gap-3"><label class="sr-only" for="aircraft-search">Search aircraft</label><input id="aircraft-search" name="q" placeholder="Search by make, model, or location..." class="w-full bg-white text-neutral-900 rounded-lg px-5 py-4"/><button class="rounded-lg px-6 bg-white text-primary-700 font-semibold">Search</button></form><div class="mt-6 flex gap-4 justify-center"><a href="/aircraft" class="bg-white text-primary-700 rounded-lg px-6 py-3 font-semibold">Browse</a><a href="/sell" class="border border-white rounded-lg px-6 py-3 font-semibold">Sell</a></div></div></section><section class="bg-neutral-50"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20"><div class="text-center mb-12"><h2 class="text-3xl font-bold text-neutral-900 sm:text-4xl">Featured Aircraft</h2><p class="mt-4 text-lg text-neutral-600">Discover our handpicked selection of premium aircraft</p></div><div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">{aircraft.slice(0,3).map(item=><AircraftCard aircraft={item} primaryPhoto={item.photos.find(p=>p.is_primary)||item.photos[0]}/>)}</div>{!aircraft.length && <p class="text-center">No aircraft available right now.</p>}<div class="mt-12 text-center"><a href="/aircraft" class="inline-block rounded-lg bg-primary-600 text-white px-6 py-3 font-semibold">View All Aircraft</a></div></div></section><section class="bg-primary-600 text-center py-20 px-4 text-white"><h2 class="text-3xl font-bold">Ready to List Your Aircraft?</h2><p class="mt-4 text-xl text-primary-100">Connect with qualified buyers through ZuluNiner.</p><a href="/sell" class="inline-block mt-8 bg-white text-primary-700 rounded-lg px-6 py-3 font-semibold">List Your Aircraft</a></section></Site>
