---
import Site from '../layouts/Site.astro';
---
<Site title="Connect ZuluNiner" noindex><section class="max-w-lg mx-auto px-6 py-20"><h1 class="text-3xl font-bold mb-4">Connect ZuluNiner</h1><p id="intro">Add https://zuluniner.com/api/mcp to your agent using OAuth, then approve access here.</p><div id="connection" hidden><p class="mb-6">Connect <strong id="client-name">your agent</strong> to manage ZuluNiner content.</p><p id="error" class="text-red-700 mb-4" role="alert"></p><form id="sign-in" class="space-y-4"><p>Sign in with the existing site owner account.</p><label class="block">Owner email<input id="email" type="email" autocomplete="email" required class="block w-full rounded-lg border border-neutral-300 mt-2 px-4 py-3"/></label><button class="bg-primary-600 text-white px-6 py-3 rounded-lg">Email a sign-in code</button></form><form id="verify-code" hidden class="space-y-4"><p>Enter the code sent to your email.</p><label class="block">Sign-in code<input id="code" autocomplete="one-time-code" inputmode="numeric" required class="block w-full rounded-lg border border-neutral-300 mt-2 px-4 py-3"/></label><button class="bg-primary-600 text-white px-6 py-3 rounded-lg">Sign in</button></form><div id="consent" hidden><p id="signed-in" class="mb-4"></p><ul class="list-disc pl-6 mb-6"><li>Read published content and drafts.</li><li id="write-scope">Create, edit, publish and delete posts, aircraft and their images.</li></ul><div class="flex gap-3"><button id="approve" class="bg-primary-600 text-white px-6 py-3 rounded-lg">Connect agent</button><button id="deny" class="border border-neutral-300 px-6 py-3 rounded-lg">Deny</button></div><button id="sign-out" class="block mt-6 underline">Sign out</button></div></div></section></Site>
<script>
import {createAuthClient} from '@neondatabase/auth';
const auth=createAuthClient('https://ep-empty-morning-b37xphuv.neonauth.c-4.ap-southeast-1.aws.neon.tech/neondb/auth');
const requestId=new URLSearchParams(location.search).get('request_id');
const select=<T extends HTMLElement>(id:string)=>document.getElementById(id) as T;
let token='';
function busy(value:boolean){document.querySelectorAll<HTMLButtonElement>('button').forEach(button=>button.disabled=value);}
function error(value:unknown){select('error').textContent=value instanceof Error?value.message:String(value);}
async function restore(){const session=await auth.getSession();if(session.error)throw new Error(session.error.message);if(session.data?.user){const jwt=await auth.token();if(jwt.error||!jwt.data?.token)throw new Error(jwt.error?.message||'Could not restore owner session.');token=jwt.data.token;select('sign-in').hidden=true;select('verify-code').hidden=true;select('consent').hidden=false;select('signed-in').textContent=`Signed in as ${session.data.user.email}.`;}else{token='';select('sign-in').hidden=false;select('consent').hidden=true;}}
if(requestId){select('intro').hidden=true;select('connection').hidden=false;void(async()=>{try{const response=await fetch(`/api/oauth/request?request_id=${encodeURIComponent(requestId)}`);const result=await response.json() as {error?:string;client_name:string;scope:string;redirect_url:string};if(!response.ok)throw new Error(result.error);select('client-name').textContent=result.client_name;select('write-scope').hidden=!result.scope.includes('content:write');await restore();}catch(e){error(e);select<HTMLButtonElement>('approve').disabled=true;}})();}
select('sign-in').addEventListener('submit',event=>{event.preventDefault();void(async()=>{busy(true);try{const result=await auth.emailOtp.sendVerificationOtp({email:select<HTMLInputElement>('email').value,type:'sign-in'});if(result.error)throw new Error(result.error.message);select('sign-in').hidden=true;select('verify-code').hidden=false;select<HTMLInputElement>('code').focus();}catch(e){error(e);}finally{busy(false);}})();});
select('verify-code').addEventListener('submit',event=>{event.preventDefault();void(async()=>{busy(true);try{const result=await auth.signIn.emailOtp({email:select<HTMLInputElement>('email').value,otp:select<HTMLInputElement>('code').value});if(result.error)throw new Error(result.error.message);await restore();}catch(e){error(e);}finally{busy(false);}})();});
async function decide(approved:boolean){busy(true);try{const response=await fetch('/api/oauth/request',{method:'POST',headers:{'Content-Type':'application/json',Authorization:`Bearer ${token}`},body:JSON.stringify({request_id:requestId,approved})});const result=await response.json() as {error?:string;client_name:string;scope:string;redirect_url:string};if(!response.ok)throw new Error(result.error);location.assign(result.redirect_url);}catch(e){error(e);busy(false);}}
select('approve').addEventListener('click',()=>void decide(true));select('deny').addEventListener('click',()=>void decide(false));select('sign-out').addEventListener('click',()=>void(async()=>{try{await auth.signOut();await restore();}catch(e){error(e);}})());
</script>
