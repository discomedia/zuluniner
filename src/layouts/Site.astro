---
import '../styles/global.css';
import Footer from '../components/Footer';
import { OrganizationStructuredData, WebsiteStructuredData } from '../components/seo/StructuredData';
interface Props { title?:string; description?:string; image?:string; noindex?:boolean }
const {title='ZuluNiner - Premier Aircraft Marketplace',description='The premier marketplace for aircraft sales and purchases. Connecting pilots, dealers, and aviation enthusiasts worldwide.',image,noindex=false}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site);
const navigation=[['Browse','/aircraft'],['Sell','/sell'],['Blog','/blog'],['About','/about'],['Contact','/contact']];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content="website"/>{image && <meta property="og:image" content={new URL(image,Astro.site)}/>}<meta name="twitter:card" content={image?'summary_large_image':'summary'}/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/>{noindex && <meta name="robots" content="noindex,nofollow"/>}<link rel="icon" href="/favicon.ico" sizes="any"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/><link rel="manifest" href="/site.webmanifest"/><meta name="theme-color" content="#1e293b"/><OrganizationStructuredData/><WebsiteStructuredData/></head><body class="antialiased bg-background text-foreground"><header class="bg-white shadow-sm border-b border-neutral-200"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"><div class="flex justify-between items-center h-16"><a href="/" class="text-2xl font-bold text-primary-600">ZuluNiner</a><nav class="hidden md:flex space-x-8" aria-label="Main navigation">{navigation.map(([name,href])=><a href={href} class="text-neutral-600 hover:text-primary-600">{name}</a>)}</nav><details class="md:hidden relative"><summary class="cursor-pointer text-neutral-600">Menu</summary><nav aria-label="Mobile navigation" class="absolute right-0 top-8 z-50 w-48 bg-white shadow-lg rounded-lg p-3">{navigation.map(([name,href])=><a href={href} class="block py-2 text-neutral-600">{name}</a>)}</nav></details></div></div></header><main><slot/></main><Footer/></body></html>
